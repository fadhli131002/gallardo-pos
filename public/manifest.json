{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/?source=pwa",
  "name": "Gallardo Autosport POS",
  "short_name": "Gallardo POS",
  "description": "Sistem Point of Sale, Manajemen Inventory, Finansial & Operasional Gallardo Autosport",
  "lang": "id",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0B0F19",
  "theme_color": "#0B0F19",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "POS Kasir",
      "short_name": "Kasir",
      "description": "Buka modul Point of Sale untuk transaksi kasir",
      "url": "/sales/pos",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Dashboard Finansial",
      "short_name": "Finance",
      "description": "Pantau arus kas riil, piutang, dan laba rugi",
      "url": "/finance/dashboard",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Master Stok Gudang",
      "short_name": "Inventory",
      "description": "Pantau stok fisik material dan mutasi barang",
      "url": "/inventory-portal/dashboard",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
