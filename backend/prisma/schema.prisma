generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  username String @unique
  password String
  role     String
}

model Transaction {
  id                Int               @id @default(autoincrement())
  sales_id          Int
  customer_name     String?
  customer_phone    String?
  customer_address  String?
  car_brand         String?
  car_model         String?
  plate_number      String?
  chassis_number    String?
  engine_number     String?
  car_year          String?
  car_color         String?
  installation_date String?
  installation_time String?
  total_amount      Float
  sales_commission  Float?
  discount          Float             @default(0)
  sisa_tagihan      Float
  status_pembayaran String            @default("Proses")
  type              String            @default("WORKSHOP")
  event             String?           // Nama sales/PIC yang bertugas (misal: "Femy", "Rosyid")
  payment_type      String?
  payment_method    String?
  termin_schedule   String?
  notes             String?
  branch            String            @default("Gallardo") // Cabang tempat order dibuat
  additional_discount Float?          @default(0)
  refund_amount       Float?          @default(0)
  refund_reason       String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  payments          Payment[]
  items             TransactionItem[]
  inventory_logs    InventoryLog[]
  complaints        Complaint[]
  cash_flow_logs    CashFlowLog[]
}

model TransactionItem {
  id             Int         @id @default(autoincrement())
  transaction_id Int
  product_name   String
  product_note   String?
  price          Float       @default(0)
  quantity       Float       @default(1)
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
}

model Payment {
  id             Int         @id @default(autoincrement())
  transaction_id Int
  amount         Float
  method         String
  notes          String?
  payment_proof  String?
  payment_date   DateTime    @default(now())
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
}

model Inventory {
  id           String         @id  // e.g. "INV-001"
  kategori     String
  brand        String
  varian       String
  kegelapan    String?
  harga_jual   Float          @default(0)   // Harga Jual dari perusahaan / Super Admin
  harga_modal  Float          @default(0)   // HPP per unit (diinput dari dashboard finance untuk laporan laba/rugi)
  stok_utama   Int            @default(0)   // stok dalam satuan utama (Roll / Botol / Pcs)
  stok_pecahan Float          @default(0)   // sisa dalam satuan pecahan (meter/ml/dll)
  satuan       String         @default("Pcs")
  branch       String         @default("Gallardo")
  konversi     Int            @default(1)   // 1 Roll = 15 meter / 1 Botol = 50 aplikasi
  min_stok     Int            @default(2)   // batas peringatan stok menipis
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  logs         InventoryLog[]
}

model InventoryLog {
  id             Int          @id @default(autoincrement())
  inventory_id   String
  transaction_id Int?
  jenis          String       // "DEDUCT" | "RESTOCK" | "ADJUST"
  jumlah         Float        // jumlah base unit yang berubah
  stok_sebelum   Float
  stok_sesudah   Float
  keterangan     String?
  created_at     DateTime     @default(now())
  inventory      Inventory?   @relation(fields: [inventory_id], references: [id])
  transaction    Transaction? @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
}

model Complaint {
  id             Int         @id @default(autoincrement())
  transaction_id Int
  problem_type   String
  description    String?
  proof_photo    String?
  status         String      @default("Pending")
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
}

model Vehicle {
  id         Int      @id @default(autoincrement())
  brand      String
  model      String
  size       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model SalesCategory {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ProductPeruntukan {
  id         Int      @id @default(autoincrement())
  name       String
  category   String   // PPF, Coating, Kaca Film, dll
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model PosisiPemasangan {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model PosisiPartial {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Expense {
  id          Int      @id @default(autoincrement())
  title       String   // e.g., "Gaji Karyawan Juli", "Sewa Ruko"
  category    String   // "Operational", "Salary", "Utility", "Other"
  amount      Float
  date        DateTime @default(now())
  proofUrl    String?  // Lampiran foto nota/kwitansi
  created_at  DateTime @default(now())
}

model CashFlowLog {
  id          Int      @id @default(autoincrement())
  type        String   // "IN" (Masuk) atau "OUT" (Keluar)
  amount      Float
  description String
  referenceId    String?      // ID Transaksi atau ID Expense
  transaction_id Int?
  transaction    Transaction? @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
}

model PurchaseOrder {
  id          Int      @id @default(autoincrement())
  supplier    String
  totalAmount Float
  status      String   @default("Pending") // "Pending", "Received"
  date        DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model SalesMaster {
  id         Int      @id @default(autoincrement())
  sales_id   String   @unique // e.g. "#S01"
  nama       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model MasterPotonganPPF {
  id              Int      @id @default(autoincrement())
  ukuranKendaraan String   // e.g., "Small", "Medium", "Large", "Semua Ukuran"
  peruntukan      String   // e.g., "Full Body Mobil", "Partial", "Raket Padel"
  potonganCm      Float
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([ukuranKendaraan, peruntukan])
}

// Audit Trail — mencatat setiap perubahan sensitif pada transaksi & stok
// old_value & new_value hanya menyimpan atribut yang berubah (bukan full object)
model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int
  user_name   String
  action      String   // "CANCEL_INVOICE" | "MARK_PAID" | "EDIT_PRICE" | "STOCK_ADJUST" | "EDIT_DISCOUNT"
  target_type String   // "Transaction" | "InventoryLog"
  target_id   Int
  reason      String?
  old_value   String?  // JSON: hanya field yang berubah, contoh: {"sisa_tagihan": 500000, "status": "Proses"}
  new_value   String?  // JSON: nilai baru setelah perubahan
  created_at  DateTime @default(now())
}

model Notification {
  id             Int       @id @default(autoincrement())
  user_id        Int?      // Target user ID (PIC Sales)
  target_sales   String?   // Nama Sales / PIC (misal: "Rosyid")
  sender_id      Int?      // ID Admin/Superadmin yang menegur
  sender_name    String?   // Nama Admin
  transaction_id Int?      // ID transaksi terkait
  type           String    @default("DUPLICATE_WARNING")
  title          String
  message        String
  is_read        Boolean   @default(false)
  created_at     DateTime  @default(now())
}

model DeletionRequest {
  id             Int       @id @default(autoincrement())
  transaction_id Int?      // ID transaksi terkait di database
  customer_id    String?   // Formatted ID / Order ID (misal "#0024" atau "RTL-DB-12")
  customer_name  String    // Nama pelanggan
  customer_phone String?   // Kontak HP pelanggan
  plate_number   String?   // Plat nomor kendaraan
  car_brand      String?   // Merk / tipe kendaraan
  total_amount   Float?    // Total nominal transaksi
  cashier_id     Int?      // User ID kasir/sales yang meminta hapus
  cashier_name   String    // Nama kasir/sales
  reason         String    // Alasan pengajuan hapus
  status         String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  action_by_id   Int?      // User ID Superadmin yang memproses
  action_by_name String?   // Nama Superadmin
  action_reason  String?   // Alasan/catatan jika ditolak/disetujui
  action_at      DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@map("deletion_requests")
}

model ReleaseNote {
  id           Int      @id @default(autoincrement())
  version      String   // e.g. "v2.5.0"
  title        String   // e.g. "Pembaruan Fitur Laporan Keuangan & Approval Hapus Data"
  content      String   // Konten deskripsi rilis
  is_published Boolean  @default(true)
  author_id    Int?
  author_name  String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("release_notes")
}
